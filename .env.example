# LLM provider: ollama | openai | stub
VITE_LLM_PROVIDER=stub

# ─── Local Ollama development (browser-safe) ─────────────────────────────────
# Direct http://localhost:11434 works when the app is opened at localhost:5173.
# VITE_OLLAMA_BASE_URL=http://localhost:11434
VITE_LLM_MODEL=llama3.2

# ─── Remote OpenAI-compatible provider (server proxy only) ───────────────────
# Set VITE_LLM_PROVIDER=openai and configure SERVER-SIDE secrets below.
# Browser bundles must never include remote API keys.
# LLM_ENDPOINT=https://api.openai.com/v1/chat/completions
# LLM_API_KEY=sk-your-key-here
# LLM_PROXY_TIMEOUT_MS=60000

# Do NOT put remote provider keys in VITE_* variables — they are bundled client-side.

# Force offline stub (no network calls)
# VITE_LLM_PROVIDER=stub

# Cyber lab harness — route through dev-server proxy (recommended)
# VITE_CYBER_LAB_USE_SERVER_PROXY=true
# CYBER_LAB_HARNESS_URL=http://localhost:8090/lab/atomic
# Or call an external harness directly (client-side; validate responses strictly):
# VITE_CYBER_LAB_HARNESS_URL=http://localhost:8090/lab/atomic
# Dev/test only — allows in-process cyber simulation without external harness (never in production)
# VITE_CYBER_ALLOW_IN_PROCESS_LAB=true

# Opt-in raw LLM text retention in browser persistence (default off)
# VITE_INTEL_RETAIN_RAW_MODEL_TEXT=true
# Dev-only console logging of raw LLM responses
# VITE_INTEL_DEBUG_LLM=true

# Map style
# VITE_MAP_STYLE_MODE=osm-light
# VITE_MAP_PMTILES_BASE_URL=http://localhost:3000/satellite.pmtiles
# VITE_MAP_PMTILES_DEM_URL=http://localhost:3000/dem.pmtiles

# ─── Intel ingest (broker-agnostic Kafka API; Redpanda for local dev) ─────────
# Start Redpanda: docker compose -f docker-compose.redpanda.yml up -d
# Seed sample reports: npm run redpanda:seed
# KAFKA_BROKERS=127.0.0.1:19092
# KAFKA_TOPIC=intel.raw
# KAFKA_GROUP_ID=coda2-ingest
# KAFKA_CLIENT_ID=coda2-ingest
# KAFKA_INGEST_ENABLED=true
# KAFKA_FROM_BEGINNING=false
# Optional auth for POST /api/intel/ingest
# INTEL_INGEST_API_KEY=dev-local-only
# Browser polling bridge (dev server proxies ingest API)
# VITE_INTEL_INGEST_SYNC=true
# VITE_INTEL_INGEST_POLL_MS=3000
# VITE_INTEL_INGEST_AUTO_RUN=true
# Lightweight ingest metrics window (polls /api/intel/ingest/status only)
# VITE_INTEL_FEED_WINDOW=true
# VITE_INTEL_FEED_POLL_MS=1000
